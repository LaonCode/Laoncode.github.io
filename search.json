---
layout: null
---
[{% for post in site.posts %}{"title":{{ post.title | jsonify }},"url":{{ post.url | jsonify }},"image":{{ post.image | default: '' | jsonify }},"date":"{{ post.date | date: '%Y-%m-%d' }}","category":{{ post.categories.first | jsonify }},"tags":{{ post.tags | jsonify }},"summary":{{ post.excerpt | strip_html | normalize_whitespace | truncate: 180 | jsonify }},"text":{{ post.content | strip_html | normalize_whitespace | jsonify }},"legacy":{{ post.legacy_url | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
